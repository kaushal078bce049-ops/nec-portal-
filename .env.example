# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row level security — never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this deployment. Used for the same-origin check on
# state-changing requests, so it must be exact.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# There are NO payment settings. All portal content is free to everyone, and
# the payment gateways, pricing page and premium tier have been removed.
# ---------------------------------------------------------------------------

# Optional. The account that signs in with this address is promoted to admin
# the first time it is seen -- but only while the database contains no
# administrator at all, so it cannot be used to re-promote anyone later.
# Manage roles from /admin/users once the first admin exists.
ADMIN_BOOTSTRAP_EMAIL=

# UploadThing -- hosts the downloadable PDF and Word editions, the diagrams in
# questions and theory, and forum attachments.
#
# Server-only: the token carries a live secret key. Get it from
# uploadthing.com -> your app -> API Keys. Without it the site still works;
# the downloads page says the editions have not been published yet.
UPLOADTHING_TOKEN=

# Signs the guest-attempt cookie (free papers without an account).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
GUEST_SESSION_SECRET=
